# Copy this file to .env and fill in your values.  .env is gitignored — never
# commit real secrets. In production (Railway/Render) set these in the host's
# dashboard, not in a file.
#
# Every value below is read by config.py via os.environ. A blank value means
# "not set" (the matching agent will report "not configured" until you fill it),
# so this is the ONE place to point the app at a UAT vs production environment —
# no code changes anywhere.

# ── Refold (Cobalt) credentials — from your UAT account ──────────────────────
REFOLD_API_KEY=                # Cobalt X-API-Key (SECRET)
REFOLD_LINKED_ACCOUNT_ID=      # Cobalt linked_account_id
REFOLD_API_BASE=https://cobalt-skc.uscentral1.gocobalt.io   # change if UAT uses a different Cobalt host
# REFOLD_CONFIG_ID=            # optional per-run config header

# ── Workflow IDs + slugs — the NEW ids from your export-import into UAT ───────
# (Each agent needs its workflow id; slug is the header Cobalt expects.)
REFOLD_MEETING_PREP_WORKFLOW_ID=
REFOLD_MEETING_PREP_SLUG=
REFOLD_RENEWAL_WORKFLOW_ID=
REFOLD_RENEWAL_SLUG=
REFOLD_CHURN_WORKFLOW_ID=
REFOLD_CHURN_SLUG=
REFOLD_BRIEFING_WORKFLOW_ID=
REFOLD_BRIEFING_SLUG=
REFOLD_PIPELINE_WORKFLOW_ID=
REFOLD_PIPELINE_SLUG=
REFOLD_FORECAST_WORKFLOW_ID=
REFOLD_FORECAST_SLUG=

# ── App ──────────────────────────────────────────────────────────────────────
# AGENT_API_TOKEN must match the bearer token the Cobalt workflows send when they
# call this CRM's /api/agent/* endpoints. Set the same value here and in Cobalt.
AGENT_API_TOKEN=
SECRET_KEY=
